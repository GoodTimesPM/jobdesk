# Copy to .env.apply and fill in. Every .env* file is git-ignored -
# never commit one.
# Everything here is OPTIONAL: without it, `jobdesk.apply.main auto` reports why and
# builds nothing, and every other command still works.

# -- Notion (the "Date Applied" trigger + the OG tracker sync, 2026-08-20) --
# NOTION_API_KEY / NOTION_JOBS_DB can be left unset here -- notion_sync.py
# falls back to reading them out of .env.radar, since it's the same
# integration and the same Job Radar Tracker database. Only set them here if
# apply ever needs a different Notion connection than radar's.
NOTION_API_KEY=
NOTION_JOBS_DB=

# The OG Job & Internship Tracker's database ID -- an older tracker you
# already apply from by hand, separate from the Job Radar Tracker above.
# Find it in the database's Notion URL: notion.so/<workspace>/<32-char-id>.
# Share the database with the same integration used for NOTION_API_KEY first
# (Notion integrations see nothing until a page is explicitly shared).
NOTION_OG_TRACKER_DB=
