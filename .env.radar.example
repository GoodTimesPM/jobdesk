# Copy to .env.radar and fill in. Every .env* file is git-ignored -
# never commit one.
# Every value here is OPTIONAL: the radar runs without any of them, it just
# runs with fewer sources and queues its Notion rows to a file instead.

# -- Notion (plan item 7) ---------------------------------------------------
# Create a connection (internal integration) at
# https://www.notion.so/my-integrations -> New connection -> Access token,
# copy its secret (starts with ntn_) here, then SHARE the job tracker database
# with it: open the DB -> the "..." menu -> Connections -> add it. Notion
# integrations can see NOTHING until a page is explicitly shared, so skipping
# that share is the #1 cause of a token that authenticates but 404s on write.
# Without these two, rows go to data/radar/notion_queue.json and nothing pushes them
# through the MCP connection instead.
NOTION_API_KEY=ntn_your_integration_secret_here
NOTION_JOBS_DB=your_32_char_database_id_here

# -- Discord (the push surface, plan item 3) --------------------------------
# A webhook, NOT the bot token. In Discord: pick (or make) a channel just for
# job hits -> Edit Channel -> Integrations -> Webhooks -> New Webhook ->
# Copy Webhook URL. Keep it a separate channel from the DOMAIN EXPANSION news
# feed. Unset, the radar simply skips the ping and still writes Notion + the
# digest. Test it without a full run: py tests/test_radar.py --discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# -- Adzuna (free tier, https://developer.adzuna.com/) ----------------------
# The only free source here that reliably carries salary data.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# -- USAJobs (free, https://developer.usajobs.gov/apirequest/) --------------
# USAJOBS_EMAIL is sent as the User-Agent - that is what their API expects.
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# -- hiring.cafe ------------------------------------------------------------
# Left blank deliberately. hiring.cafe has no public API - its search
# endpoint returns 401 without a logged-in session token, so using it here
# would mean replaying private session auth against an undocumented
# endpoint. That is the same risk category as scraping LinkedIn, so the
# source ships disabled in jobdesk/radar/sources/__init__.py.
# Recommended instead: turn on hiring.cafe's own email alerts and let them
# arrive through the IMAP lane (plan item 12).
HIRINGCAFE_TOKEN=

# -- MySQL (Richmond Job Market Dashboard, plan item 11) --------------------
# Local MySQL server. Create a scoped user (NOT root) with:
#   CREATE DATABASE job_radar CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER '<user>'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON job_radar.* TO '<user>'@'localhost';
# Unset, raw-postings ingestion just no-ops and the run is unaffected.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=job_radar
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# -- Where the daily market snapshot goes ----------------------------------
# One structured file per run: what the market looked like that morning,
# without the JD bodies. Unset, it lands in data/radar/snapshots/ with
# everything else. Point it at another project's data folder if something
# other than JobDesk analyses the series.
JOBDESK_SNAPSHOTS=
